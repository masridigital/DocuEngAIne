# Microsoft Entra ID (MSAL) configuration for the SPA.
# Copy to .env.local for local development; CI supplies these at build time.
# Vite inlines VITE_* values into the bundle, so these are public values only —
# never put a client secret here.

# Application (client) ID of the Entra app registration for this SPA.
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# v2.0 authority for your tenant.
VITE_ENTRA_AUTHORITY=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0

# Scope exposed by the DocuEngAIne API app registration; requested for every API call.
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access
